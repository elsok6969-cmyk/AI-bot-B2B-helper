# Telegram
BOT_TOKEN=
OWNER_TELEGRAM_ID=

# AI provider: "anthropic" (production, Claude) or "kimi" (Moonshot AI,
# OpenAI-compatible — cheap option for local/staging tests).
AI_PROVIDER=anthropic

# Anthropic — required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Kimi (Moonshot AI) — required when AI_PROVIDER=kimi. Models below are
# defaults; override if you want a different size/region.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_FAST=moonshot-v1-8k
KIMI_MODEL_SMART=kimi-k2-0905-preview
KIMI_MODEL_VISION=moonshot-v1-32k-vision-preview

# Database (the host "postgres" is the docker-compose service name)
DATABASE_URL=postgresql+asyncpg://mynota:password@postgres:5432/mynota
POSTGRES_USER=mynota
POSTGRES_PASSWORD=password
POSTGRES_DB=mynota

# Runtime
LOG_LEVEL=INFO
TZ=Europe/Moscow

# --- Web UI (FastAPI dashboard, localhost only by default) ---
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8090

# --- Secrets vault (Fernet key) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt Telethon session strings and mailbox passwords at rest.
SECRETS_KEY=

# --- Telethon (personal Telegram account ingestion) ---
TELETHON_ENABLED=true
# Get from https://my.telegram.org → API Development Tools.
TELETHON_API_ID=
TELETHON_API_HASH=

# --- Yandex Mail (IMAP + SMTP). Use an app password, not your main pass. ---
MAIL_ENABLED=true
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.yandex.ru
MAIL_SMTP_PORT=465
MAIL_POLL_INTERVAL_MINUTES=2

# --- Drafts queue ---
# true = AI generates reply variants for every inbound; you approve from web.
DRAFTS_AUTOGENERATE=true
